{
  "name": "formsoftware",
  "private": true,
  "version": "0.6.0",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --dir web build",
    "check": "pnpm --dir web check",
    "test:web": "pnpm --dir web test",
    "format": "prettier --write web/src docs spec README.md package.json",
    "contracts": "cargo run -q -p form-server -- --openapi > contracts/openapi.json && openapi-typescript contracts/openapi.json -o web/src/api/schema.d.ts",
    "test:api": "node scripts/test-api.mjs",
    "dev:setup": "node scripts/dev.mjs setup",
    "desktop": "cargo run -p form-desktop",
    "backup:check": "node scripts/backup-check.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix"
  },
  "devDependencies": {
    "autocorrect-node": "2.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "markdownlint-cli2": "0.23.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
